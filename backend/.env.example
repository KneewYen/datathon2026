AWS_REGION=us-east-1
AWS_PROFILE=portfolioguard-workshop
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
LAMBDA_FUNCTION_NAME=portfolioguard-workshop-financial-tools
S3_BUCKET=REPLACE_WITH_STACK_OUTPUT
DATA_PREFIX=starter/v1
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Leave ENGINE unset (or "lambda") when deployed: every calculation runs in the Lambda and the
# market data comes from S3. "local" runs the same code against the repo's data folder, for
# tests and offline work only.
# ENGINE=lambda

# The agents run in Amazon Bedrock AgentCore, in your AWS account. Set the runtime ARN from the
# agents stack output (AgentRuntimeArn). AGENTS=local runs the same agents in this process, for
# tests and offline work only; with the default (agentcore) a missing ARN is an error, never a
# silent local fallback.
# AGENTS=agentcore
AGENT_RUNTIME_ARN=
