NEXT_PUBLIC_API_URL=http://localhost:8000
# Leave the Cognito values blank for local FastAPI development. After an approved
# AWS deployment, use the stack outputs and exact callback/logout URLs. These are
# public OAuth client identifiers and endpoints, never client secrets.
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_REDIRECT_URI=http://localhost:3000/auth/callback
NEXT_PUBLIC_COGNITO_LOGOUT_URI=http://localhost:3000
