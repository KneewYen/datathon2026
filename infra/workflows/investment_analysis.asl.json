{
  "Comment": "PortfolioGuard AI cross-account investment intelligence workflow",
  "TimeoutSeconds": 180,
  "StartAt": "Prepare Investment Request",
  "States": {
    "Prepare Investment Request": {
      "Type": "Task",
      "Resource": "${CoordinatorFunctionArn}",
      "Parameters": {
        "operation": "prepare",
        "request_id.$": "$.request_id",
        "request.$": "$.request"
      },
      "Next": "Clarification Required?",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ]
    },
    "Clarification Required?": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.context.status",
          "StringEquals": "clarification_required",
          "Next": "Finalize Clarification"
        }
      ],
      "Default": "Global Planner Agent"
    },
    "Finalize Clarification": {
      "Type": "Task",
      "Resource": "${CoordinatorFunctionArn}",
      "Parameters": {
        "operation": "finalize_clarification",
        "context.$": "$.context",
        "trace.$": "$.trace"
      },
      "End": true
    },
    "Global Planner Agent": {
      "Type": "Task",
      "Resource": "${AgentFunctionArn}",
      "Parameters": {
        "role": "global_orchestrator",
        "request_id.$": "$.context.request_id",
        "parent_id": "orchestrator.intent",
        "context.$": "$.context"
      },
      "ResultPath": "$.agents.global",
      "Next": "Analyze Accounts in Parallel"
    },
    "Analyze Accounts in Parallel": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "Analyze TFSA?",
          "States": {
            "Analyze TFSA?": {
              "Type": "Choice",
              "Choices": [
                {
                  "Variable": "$.context.selected.TFSA",
                  "BooleanEquals": true,
                  "Next": "TFSA Account Agent"
                }
              ],
              "Default": "Skip TFSA"
            },
            "Skip TFSA": {
              "Type": "Pass",
              "Result": {"account_type": "TFSA", "skipped": true},
              "ResultPath": "$.branch_status",
              "End": true
            },
            "TFSA Account Agent": {
              "Type": "Task",
              "Resource": "${AgentFunctionArn}",
              "Parameters": {
                "role": "tfsa_account_agent",
                "request_id.$": "$.context.request_id",
                "parent_id": "orchestrator.intent",
                "context.$": "$.context"
              },
              "ResultPath": "$.agents.tfsa",
              "Next": "Growth Strategy Agent"
            },
            "Growth Strategy Agent": {
              "Type": "Task",
              "Resource": "${AgentFunctionArn}",
              "Parameters": {
                "role": "growth_strategy_agent",
                "request_id.$": "$.context.request_id",
                "parent_id": "agent.tfsa_account_agent",
                "context.$": "$.context"
              },
              "ResultPath": "$.agents.growth",
              "Next": "TFSA Holdings Exposure Tool"
            },
            "TFSA Holdings Exposure Tool": {
              "Type": "Task",
              "Resource": "${FinancialToolsFunctionArn}",
              "Parameters": {
                "operation": "analyze_holdings_exposure",
                "analysis_id.$": "$.context.tool_payload.analysis_id",
                "accounts.$": "$.context.tool_payload.accounts",
                "target_ticker.$": "$.context.tool_payload.target_ticker",
                "account_id": "tfsa-demo-001",
                "amount.$": "$.context.tool_payload.amount",
                "currency.$": "$.context.tool_payload.currency",
                "start_date.$": "$.context.tool_payload.start_date",
                "end_date.$": "$.context.tool_payload.end_date",
                "etf_constituents.$": "$.context.tool_payload.etf_constituents",
                "agent": "growth_strategy_agent",
                "parent_event_id": "agent.growth_strategy_agent"
              },
              "ResultPath": "$.tools.tfsa_exposure",
              "Next": "Momentum Strategy Agent"
            },
            "Momentum Strategy Agent": {
              "Type": "Task",
              "Resource": "${AgentFunctionArn}",
              "Parameters": {
                "role": "momentum_strategy_agent",
                "request_id.$": "$.context.request_id",
                "parent_id": "agent.tfsa_account_agent",
                "context.$": "$.context"
              },
              "ResultPath": "$.agents.momentum",
              "Next": "Market Snapshot Tool"
            },
            "Market Snapshot Tool": {
              "Type": "Task",
              "Resource": "${FinancialToolsFunctionArn}",
              "Parameters": {
                "operation": "market_snapshot",
                "analysis_id.$": "$.context.tool_payload.analysis_id",
                "accounts.$": "$.context.tool_payload.accounts",
                "target_ticker.$": "$.context.tool_payload.target_ticker",
                "amount.$": "$.context.tool_payload.amount",
                "currency.$": "$.context.tool_payload.currency",
                "start_date.$": "$.context.tool_payload.start_date",
                "end_date.$": "$.context.tool_payload.end_date",
                "etf_constituents.$": "$.context.tool_payload.etf_constituents",
                "agent": "momentum_strategy_agent",
                "parent_event_id": "agent.momentum_strategy_agent"
              },
              "ResultPath": "$.tools.market",
              "Next": "News Research Tool"
            },
            "News Research Tool": {
              "Type": "Task",
              "Resource": "${CoordinatorFunctionArn}",
              "Parameters": {
                "operation": "research_unavailable",
                "request_id.$": "$.context.request_id",
                "ticker.$": "$.context.intent.ticker"
              },
              "ResultPath": "$.tools.research",
              "Next": "TFSA Purchase Simulation Tool"
            },
            "TFSA Purchase Simulation Tool": {
              "Type": "Task",
              "Resource": "${FinancialToolsFunctionArn}",
              "Parameters": {
                "operation": "simulate_account_purchase",
                "analysis_id.$": "$.context.tool_payload.analysis_id",
                "accounts.$": "$.context.tool_payload.accounts",
                "target_ticker.$": "$.context.tool_payload.target_ticker",
                "amount.$": "$.context.tool_payload.amount",
                "currency.$": "$.context.tool_payload.currency",
                "start_date.$": "$.context.tool_payload.start_date",
                "end_date.$": "$.context.tool_payload.end_date",
                "etf_constituents.$": "$.context.tool_payload.etf_constituents",
                "account_id": "tfsa-demo-001",
                "agent": "growth_strategy_agent",
                "parent_event_id": "agent.growth_strategy_agent"
              },
              "ResultPath": "$.tools.tfsa_simulation",
              "Next": "TFSA Complete"
            },
            "TFSA Complete": {
              "Type": "Pass",
              "Result": {"account_type": "TFSA", "skipped": false},
              "ResultPath": "$.branch_status",
              "End": true
            }
          }
        },
        {
          "StartAt": "Analyze RRSP?",
          "States": {
            "Analyze RRSP?": {
              "Type": "Choice",
              "Choices": [
                {
                  "Variable": "$.context.selected.RRSP",
                  "BooleanEquals": true,
                  "Next": "RRSP Account Agent"
                }
              ],
              "Default": "Skip RRSP"
            },
            "Skip RRSP": {
              "Type": "Pass",
              "Result": {"account_type": "RRSP", "skipped": true},
              "ResultPath": "$.branch_status",
              "End": true
            },
            "RRSP Account Agent": {
              "Type": "Task",
              "Resource": "${AgentFunctionArn}",
              "Parameters": {
                "role": "rrsp_account_agent",
                "request_id.$": "$.context.request_id",
                "parent_id": "orchestrator.intent",
                "context.$": "$.context"
              },
              "ResultPath": "$.agents.rrsp",
              "Next": "Dividend Strategy Agent"
            },
            "Dividend Strategy Agent": {
              "Type": "Task",
              "Resource": "${AgentFunctionArn}",
              "Parameters": {
                "role": "dividend_strategy_agent",
                "request_id.$": "$.context.request_id",
                "parent_id": "agent.rrsp_account_agent",
                "context.$": "$.context"
              },
              "ResultPath": "$.agents.dividend",
              "Next": "RRSP Holdings Exposure Tool"
            },
            "RRSP Holdings Exposure Tool": {
              "Type": "Task",
              "Resource": "${FinancialToolsFunctionArn}",
              "Parameters": {
                "operation": "analyze_holdings_exposure",
                "analysis_id.$": "$.context.tool_payload.analysis_id",
                "accounts.$": "$.context.tool_payload.accounts",
                "target_ticker.$": "$.context.tool_payload.target_ticker",
                "account_id": "rrsp-demo-001",
                "amount.$": "$.context.tool_payload.amount",
                "currency.$": "$.context.tool_payload.currency",
                "start_date.$": "$.context.tool_payload.start_date",
                "end_date.$": "$.context.tool_payload.end_date",
                "etf_constituents.$": "$.context.tool_payload.etf_constituents",
                "agent": "dividend_strategy_agent",
                "parent_event_id": "agent.dividend_strategy_agent"
              },
              "ResultPath": "$.tools.rrsp_exposure",
              "Next": "Capital Preservation Strategy Agent"
            },
            "Capital Preservation Strategy Agent": {
              "Type": "Task",
              "Resource": "${AgentFunctionArn}",
              "Parameters": {
                "role": "capital_preservation_strategy_agent",
                "request_id.$": "$.context.request_id",
                "parent_id": "agent.rrsp_account_agent",
                "context.$": "$.context"
              },
              "ResultPath": "$.agents.preservation",
              "Next": "RRSP Purchase Simulation Tool"
            },
            "RRSP Purchase Simulation Tool": {
              "Type": "Task",
              "Resource": "${FinancialToolsFunctionArn}",
              "Parameters": {
                "operation": "simulate_account_purchase",
                "analysis_id.$": "$.context.tool_payload.analysis_id",
                "accounts.$": "$.context.tool_payload.accounts",
                "target_ticker.$": "$.context.tool_payload.target_ticker",
                "amount.$": "$.context.tool_payload.amount",
                "currency.$": "$.context.tool_payload.currency",
                "start_date.$": "$.context.tool_payload.start_date",
                "end_date.$": "$.context.tool_payload.end_date",
                "etf_constituents.$": "$.context.tool_payload.etf_constituents",
                "account_id": "rrsp-demo-001",
                "agent": "capital_preservation_strategy_agent",
                "parent_event_id": "agent.capital_preservation_strategy_agent"
              },
              "ResultPath": "$.tools.rrsp_simulation",
              "Next": "RRSP Complete"
            },
            "RRSP Complete": {
              "Type": "Pass",
              "Result": {"account_type": "RRSP", "skipped": false},
              "ResultPath": "$.branch_status",
              "End": true
            }
          }
        }
      ],
      "ResultPath": "$.account_branches",
      "Next": "Aggregate and Govern"
    },
    "Aggregate and Govern": {
      "Type": "Task",
      "Resource": "${CoordinatorFunctionArn}",
      "Parameters": {
        "operation": "aggregate",
        "context.$": "$.context",
        "global_agent.$": "$.agents.global",
        "branches.$": "$.account_branches",
        "trace.$": "$.trace"
      },
      "ResultPath": "$.aggregation",
      "Next": "Explainability Agent"
    },
    "Explainability Agent": {
      "Type": "Task",
      "Resource": "${AgentFunctionArn}",
      "Parameters": {
        "role": "explainability_agent",
        "aggregation.$": "$.aggregation"
      },
      "ResultPath": "$.explanation",
      "Next": "Finalize Evidence Response"
    },
    "Finalize Evidence Response": {
      "Type": "Task",
      "Resource": "${CoordinatorFunctionArn}",
      "Parameters": {
        "operation": "finalize",
        "aggregation.$": "$.aggregation",
        "explanation.$": "$.explanation"
      },
      "End": true
    }
  }
}
