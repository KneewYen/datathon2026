{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadPortfolioGuardDataset",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::portfolioguard-workshop-data-<ACCOUNT_ID>-us-east-1/starter/v1/*"
    },
    {
      "Sid": "WritePortfolioGuardLambdaLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:<ACCOUNT_ID>:log-group:/aws/lambda/portfolioguard-workshop-financial-tools:*"
    }
  ]
}
